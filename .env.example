# ===========================================
# CONFIGURACIÓN DE ENTORNO - serviuapp (Tesis)
# Copia este archivo a .env y ajusta los valores
# ===========================================

# --- Django ---
DEBUG=False
SECRET_KEY=tu-secret-key-muy-larga-y-segura-aqui-genera-una-con-django-secret-key-generator
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,maverixti.cl,www.maverixti.cl

# --- Base de Datos MySQL ---
MYSQL_DATABASE=serviuapp
MYSQL_USER=serviuapp_user
MYSQL_PASSWORD=serviuapp_pass_segura
MYSQL_ROOT_PASSWORD=root_password_segura

# --- Redis (Celery broker) ---
# No necesita configuración adicional, usa el servicio redis interno

# --- APIs de IA (opcionales, para chat) ---
# Prioridad: OLLAMA (local) > OPENAI > ANTHROPIC > DEEPSEEK > HUGGINGFACE > FALLBACK
# Solo necesitas UNA configurada para que funcione el chat

# OpenAI (GPT-4o, GPT-4o-mini, GPT-3.5-turbo)
OPENAI_API_KEY=sk-tu-openai-key

# Anthropic (Claude 3.5 Haiku, Sonnet, Opus)
ANTHROPIC_API_KEY=sk-ant-tu-anthropic-key

# DeepSeek (API compatible OpenAI, muy económico)
DEEPSEEK_API_KEY=sk-tu-deepseek-key

# Hugging Face (Inference API - modelos gratuitos)
HUGGINGFACE_API_KEY=hf_tu-huggingface-token

# --- Ollama (local, para chat sin API externa, GRATIS y PRIVADO) ---
# Instala Ollama en tu máquina: https://ollama.com/
# Luego: ollama pull mistral (o llama3, phi3, etc.)
# En Docker usa host.docker.internal para acceder al host
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral

# --- WSGI ---
WSGI_APPLICATION=serviu.wsgi

# --- Superusuario automático (opcional) ---
# Si se definen, se crea al iniciar el contenedor
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=tu_password_seguro_aqui